# =============================================================================
# FlowQ — environment variables
# Copy this file to `.env` for local non-Docker development. Inside
# docker-compose, the same variables are injected via each service's
# `environment:` block (compose does not read this file).
# =============================================================================

# ---- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flowq
POSTGRES_USER=flowq
POSTGRES_PASSWORD=flowq

# ---- API --------------------------------------------------------------------
API_PORT=3000
# Shared secret expected on every privileged API call (header: x-api-key).
# CHANGE THIS in any non-local environment.
API_KEY=dev-api-key-change-me
