{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "datasource", "uid": "grafana" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "stat",
      "id": 1,
      "title": "Throughput (jobs/s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "orientation": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(flowq_jobs_completed_total[1m]))",
          "legendFormat": "completed/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Failure rate (last 5m)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "sum(rate(flowq_jobs_failed_total[5m])) / clamp_min(sum(rate(flowq_jobs_completed_total[5m])) + sum(rate(flowq_jobs_failed_total[5m])), 1)",
          "legendFormat": "fail %",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Active workers",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "count(count by (instance) (up{job=~\".*flowq-api.*\"} == 1))",
          "legendFormat": "api pods",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_status_replicas_available{deployment=~\".*flowq-worker.*\"}",
          "legendFormat": "worker pods",
          "refId": "B"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Dead jobs (24h)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 100 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "graphMode": "area",
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "sum(increase(flowq_jobs_dead_total[24h]))",
          "legendFormat": "dead/24h",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Job throughput by queue",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "spanNulls": true,
            "stacking": { "mode": "none" }
          },
          "unit": "ops",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (queueName) (rate(flowq_jobs_completed_total[1m]))",
          "legendFormat": "{{queueName}} completed",
          "refId": "A"
        },
        {
          "expr": "sum by (queueName) (rate(flowq_jobs_failed_total[1m]))",
          "legendFormat": "{{queueName}} failed",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Queue depth (pending + active)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 20,
            "lineWidth": 2,
            "stacking": { "mode": "normal" }
          },
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (queueName, type) (flowq_queue_depth)",
          "legendFormat": "{{queueName}} / {{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 20,
      "title": "Job duration percentiles (s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5,
            "lineWidth": 2,
            "spanNulls": true
          },
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, queueName) (rate(flowq_job_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{queueName}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, queueName) (rate(flowq_job_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{queueName}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, queueName) (rate(flowq_job_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{queueName}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Worker pod count (HPA scale events)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 20,
            "lineWidth": 2,
            "stacking": { "mode": "none" }
          },
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas{deployment=~\".*flowq-worker.*\"}",
          "legendFormat": "desired",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_status_replicas_available{deployment=~\".*flowq-worker.*\"}",
          "legendFormat": "available",
          "refId": "B"
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{horizontalpodautoscaler=~\".*flowq-worker.*\"}",
          "legendFormat": "hpa max",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 30,
      "title": "Dead-letter queue rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          },
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "sum by (queueName) (increase(flowq_jobs_dead_total[5m]))",
          "legendFormat": "{{queueName}} dead / 5m",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["flowq", "queue", "jobs"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "FlowQ — Queue Engine",
  "uid": "flowq-overview",
  "version": 1,
  "weekStart": ""
}
