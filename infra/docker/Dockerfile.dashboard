# syntax=docker/dockerfile:1.7
#
# FlowQ Dashboard — production image.
#
# Stage 1 builds the Vite bundle. Stage 2 is nginx:alpine serving the
# static assets. The dashboard's API base URL, WebSocket URL, and API key
# are NOT baked into the bundle — they are written to /usr/share/nginx/html/config.js
# at container start by docker-entrypoint.sh from environment variables.
# This means the same image can be promoted from staging to prod just by
# changing env, no rebuild required.

ARG NODE_VERSION=20-alpine
ARG PNPM_VERSION=10.33.0

# ---------- deps ----------
FROM node:${NODE_VERSION} AS deps
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* tsconfig.base.json .npmrc ./
COPY packages/api/package.json       packages/api/package.json
COPY packages/sdk/package.json       packages/sdk/package.json
COPY packages/worker/package.json    packages/worker/package.json
COPY packages/dashboard/package.json packages/dashboard/package.json

RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile=false

# ---------- builder ----------
FROM deps AS builder
WORKDIR /repo
COPY packages/sdk ./packages/sdk
COPY packages/dashboard ./packages/dashboard
# SDK is workspace:* — build it first so the dashboard's TS imports resolve.
RUN pnpm --filter @flowq/sdk build \
 && pnpm --filter @flowq/dashboard build

# ---------- runtime ----------
FROM nginx:1.27-alpine AS runtime

RUN apk add --no-cache tini bash

COPY infra/docker/nginx.conf            /etc/nginx/conf.d/default.conf
COPY infra/docker/dashboard-entrypoint.sh /docker-entrypoint.d/40-flowq-config.sh
RUN chmod +x /docker-entrypoint.d/40-flowq-config.sh

COPY --from=builder /repo/packages/dashboard/dist /usr/share/nginx/html

EXPOSE 8080

# nginx:alpine ships its own /docker-entrypoint.sh that runs everything in
# /docker-entrypoint.d/ (so our 40-flowq-config.sh fires) and then execs
# the CMD. Tini wraps the whole thing for clean signal forwarding.
ENTRYPOINT ["/sbin/tini", "--", "/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
